# Copy this file to keystore.properties and fill in your own values.
# keystore.properties and *.jks are gitignored — neither belongs in the repository.
#
# Generate the keystore first (keytool ships with the JDK):
#
#   keytool -genkeypair -v \
#     -keystore procwatch-release.jks \
#     -alias procwatch \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000
#
# Keep the .jks file and these passwords backed up somewhere safe. Android identifies an app
# by its signature, so losing this keystore means you can no longer update an installed
# ProcWatch in place — you would have to uninstall it first, which discards your keep-running
# list and action log.

# Path to the keystore, relative to the project root (or absolute).
storeFile=procwatch-release.jks

storePassword=CHANGE_ME
keyAlias=procwatch
keyPassword=CHANGE_ME

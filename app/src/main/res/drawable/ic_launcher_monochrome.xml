<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Themed icons (Android 13+) discard colour and tint whatever has alpha. Pointing this
        layer at the full-colour foreground would flatten lit and unlit cells into one solid
        3x3 block — the reading, which is the entire point of the mark, would vanish.

        So the monochrome layer carries only the lit cells. The silhouette stays a bar chart
        under any tint the launcher picks. Geometry is identical to the foreground, so the
        themed and full-colour versions line up exactly.

        The fill colour is arbitrary; the system replaces it.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,64h12v12h-12z M48,32h12v12h-12z M48,48h12v12h-12z M48,64h12v12h-12z M64,48h12v12h-12z M64,64h12v12h-12z" />

</vector>

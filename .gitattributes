# Keep LF in the repository regardless of the checkout platform, so a Windows
# clone and a CI checkout produce identical blobs.
* text=auto eol=lf

# Batch files are the exception: cmd.exe can mis-parse labels and multi-line blocks when a
# .bat arrives with LF-only endings, so gradlew.bat keeps CRLF. Its shell counterpart,
# gradlew, needs LF and gets it from the rule above.
*.bat text eol=crlf

# Binary: never touch.
*.png binary
*.jpg binary
*.webp binary
*.zip binary
*.jar binary
*.keystore binary
